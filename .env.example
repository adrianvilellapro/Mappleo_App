# Local PostgreSQL used by Docker Compose. Copy this file to .env for local use.
POSTGRES_USER=mappleo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=mappleo
POSTGRES_PORT=5433

# Prisma connection to the local development database.
DATABASE_URL=postgresql://mappleo:replace-with-a-local-password@127.0.0.1:5433/mappleo?schema=public
# Generated by npm run security:prepare; the application never uses the admin connection.
DATABASE_RUNTIME_URL=
# Optional PEM CA for providers whose database certificate is not in the system trust store.
# Remote runtime connections always verify TLS certificates.
DATABASE_SSL_CA=

# Run npm run setup to generate a local secret.
AUTH_SECRET=
NEXTAUTH_URL=https://localhost:3000
# Generated ONCE by encryption:prepare. Keep an independent secure backup.
# Never remove old keys, rotate the index key or regenerate keys for an encrypted DB.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY=
FIELD_ENCRYPTION_INDEX_KEY=
# Sole administrator, provisioned by admin:prepare. Do not fill with public defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ACTION_PASSWORD=
ADMIN_TOTP_SECRET=
# Exact source IPs; requires an ingress-overwritten trusted IP header publicly.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
DATABASE_ADMIN_RUNTIME_URL=
# Public hosting: HTTPS is mandatory. Configure only an IP header overwritten by your trusted ingress.
TRUSTED_CLIENT_IP_HEADER=
# Remote registration requires explicit opt-in AND the invitation below. This does not verify email.
ALLOW_UNVERIFIED_REGISTRATION=false
# Generated registration invitation, never sent to the browser as configuration.
REGISTRATION_CODE=
# Maximum the web administrator can allow, including the sole administrator.
ACCOUNT_LIMIT_CEILING=15
# Enable only after deploying the desktop_sync migration and runtime grants.
DESKTOP_SYNC_ENABLED=false
# Reserved for future Google OAuth; currently disabled even with credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional deployment/maintenance profile (.env.deploy only). Never commit real values.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
NEON_PROJECT_ID=
NEON_PRODUCTION_BRANCH_ID=
