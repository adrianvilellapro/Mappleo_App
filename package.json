{
  "name": "mappleo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:install": "npm --prefix apps/windows ci",
    "desktop:dev": "npm --prefix apps/windows run dev",
    "desktop:build": "npm --prefix apps/windows run build",
    "desktop:start": "npm --prefix apps/windows run start",
    "desktop:test": "npm --prefix apps/windows test",
    "test:desktop-sync": "npm run desktop:build && playwright test --config playwright.sync.config.ts",
    "desktop:dist": "npm --prefix apps/windows run dist",
    "postinstall": "node scripts/apply-security-patches.mjs",
    "predev": "prisma generate && node scripts/prepare-web.mjs",
    "dev": "tsx scripts/dev-https.ts",
    "dev:test": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && node scripts/prepare-web.mjs && next build",
    "demo:build": "tsx scripts/build-demo.ts",
    "demo:preview": "node scripts/serve-demo.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:https": "node --use-system-ca node_modules/@playwright/test/cli.js test --config playwright.https.config.ts",
    "test:prepare": "tsx scripts/prepare-tests.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "security:prepare": "prisma migrate deploy && tsx scripts/security-prepare.ts",
    "security:prepare:test": "tsx scripts/security-prepare.ts --test",
    "security:maintenance": "tsx scripts/security-maintenance.ts",
    "desktop:prepare-server": "tsx scripts/desktop-sync-prepare.ts",
    "encryption:prepare": "prisma migrate deploy && tsx scripts/encryption-prepare.ts",
    "encryption:prepare:test": "tsx scripts/encryption-prepare.ts --test",
    "admin:prepare": "prisma migrate deploy && tsx scripts/admin-prepare.ts",
    "admin:prepare:test": "tsx scripts/admin-prepare.ts --test",
    "registration:prepare": "tsx scripts/registration-prepare.ts",
    "deployment:prepare": "tsx scripts/deployment-bootstrap.ts --env-file .env.deploy --allow-remote",
    "deployment:vercel": "tsx scripts/vercel-prepare.ts --apply",
    "test:deployment": "node --use-system-ca node_modules/@playwright/test/cli.js test --config playwright.deploy.config.ts",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "demo:check": "tsx scripts/seed-demo.ts --check",
    "demo:seed": "tsx scripts/seed-demo.ts --apply",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@neon/config": "^1.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "otpauth": "9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "patch-package": "8.0.1",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
